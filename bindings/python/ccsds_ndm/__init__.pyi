        :type: RdmData
        """
    @data.setter
    def data(self, value: RdmData) -> None: ...
    def __new__(cls, *, metadata: RdmMetadata, data: RdmData) -> RdmSegment: ...
    def __repr__(self) -> builtins.str: ...

