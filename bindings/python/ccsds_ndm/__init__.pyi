        Examples: ESR, NO

        :type: Optional[str]
        """
    @earth_tides.setter
    def earth_tides(self, value: typing.Optional[builtins.str]) -> None: ...
    @property
    def intrack_thrust(self) -> typing.Optional[builtins.str]:
        r"""
        Indicator on whether in-track thrust modeling was used in the simulation.

        Examples: YES, NO

        :type: Optional[str]
        """
    @intrack_thrust.setter
    def intrack_thrust(self, value: typing.Optional[builtins.str]) -> None: ...
    @property
    def drag_parameters_source(self) -> typing.Optional[builtins.str]:
        r"""
        The method used to estimate the drag parameters of the object (DRAG_AREA, DRAG_COEFF,
