        Examples: 2001-11-06T11:17:33, 2002-204T15:56:23Z

        :type: Optional[str]
        """
    @ref_frame_epoch.setter
    def ref_frame_epoch(self, value: typing.Optional[builtins.str]) -> None: ...
    @property
    def ephemeris_name(self) -> typing.Optional[builtins.str]:
        r"""
        Unique identifier of an external ephemeris file used or NONE.

        Examples: NONE, EPHEMERIS, INTELSAT2

        :type: Optional[str]
        """
    @ephemeris_name.setter
    def ephemeris_name(self, value: typing.Optional[builtins.str]) -> None: ...
    @property
    def gravity_model(self) -> typing.Optional[builtins.str]:
        r"""
        The gravity model used in the simulation. The degree (D) and order (O) of the spherical
