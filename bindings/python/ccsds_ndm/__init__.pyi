        Examples: EGM-96: 36D 36O, JGM-2: 41D 41O

        :type: Optional[str]
        """
    @gravity_model.setter
    def gravity_model(self, value: typing.Optional[builtins.str]) -> None: ...
    @property
    def atmospheric_model(self) -> typing.Optional[builtins.str]:
        r"""
        The atmosphere model(s) used in the simulation. If more than one model is used they
